#!/usr/bin/env bash
# =============================================================================
# the-whole-shebang/test - Run the test suite
# =============================================================================
# Every `#[test]` function under tests/. An entry point, so it resolves
# nutshell itself before there is a nutshell to ask.
#
# Usage:
#   ./test                          everything
#   ./test tests/tui_term_test.sh   one file
#   TEST_FILTER=restore ./test      only tests whose name contains "restore"
# =============================================================================

set -uo pipefail
HERE="${BASH_SOURCE[0]%/*}"

# shellcheck source=/dev/null
. "$HERE/lib/find-nutshell"
nutshell_find "" "${SHEBANG_NUTSHELL_REF:-0.4.1}" || exit 1
# shellcheck source=/dev/null
. "$NUTSHELL_INIT" || exit 1

# Resolved once, and everything a test starts inherits it. Without this each
# subshell resolves the pin again, and the tests set their own XDG directories,
# so the resolution stamp is somewhere else every time and every one of them
# asks the remote. A suite that reaches the network is a suite that fails on a
# train.
NUTSHELL_HOME="${NUTSHELL_INIT%/init}"
export NUTSHELL_HOME NUTSHELL_INIT

use test log

if [[ $# -gt 0 ]]; then
    # A named file that is not there is an error rather than an empty run. A
    # green suite that ran nothing is the one result a test command must never
    # give, and a mistyped path is the usual way to get one.
    for f in "$@"; do
        if [[ ! -f "$f" ]]; then
            log_error "no such test file: ${f}"
            exit 2
        fi
    done
    for f in "$@"; do
        log_step "${f##*/}"
        test_run "$f"
    done
else
    test_run_dir "$HERE/tests"
fi

test_summary
